import App   from CajyuLibs.Orgapp;
import Hash  from CajyuLibs.auth;
import Token from CajyuLibs.auth;
import cache from CajyuLibs.cache;
import print from CajyuLibs.serial;

var db = {
  users: [],
  nextId: 1
};

var session = cache();
var app     = new App(3000);

app.use(fn ctx, res, next {
  print("[" + ctx.type + "] " + ctx.url);
  wait next();
});

app.use(fn ctx, res, next {
  var publicRoutes = ["/", "/login", "/register"];
  var isPublic = false;
  for route in publicRoutes {
    if route == ctx.url {
      isPublic = true;
    }
  }
  if isPublic {
    wait next();
    return;
  }
  var token  = ctx.headers["x-token"];
  var userId = wait session.get("token:" + token);
  if !userId {
    ctx.unauthorized = true;
  } else {
    ctx.userId = userId;
  }
  wait next();
});

app.get("/", fn ctx {
  return "<html><body>" +
    "<h1>Orgapp Example</h1>" +
    "<p>Available routes:</p>" +
    "<ul>" +
    "<li>POST /register — { name, password }</li>" +
    "<li>POST /login    — { name, password }</li>" +
    "<li>GET  /profile  — x-token required</li>" +
    "<li>GET  /users    — x-token required</li>" +
    "<li>POST /post     — { title, body } + x-token</li>" +
    "<li>GET  /posts    — x-token required</li>" +
    "</ul></body></html>";
});

app.post("/register", fn ctx {
  if ctx.unauthorized {
    return { error: "Unauthorized", code: 401 };
  }
  var name     = ctx.body.name;
  var password = ctx.body.password;
  if !name or !password {
    return { error: "name and password are required", code: 400 };
  }
  var exists = false;
  for u in db.users {
    if u.name == name {
      exists = true;
    }
  }
  if exists {
    return { error: "User already exists", code: 409 };
  }
  var hash = new Hash(password);
  var user = {
    id:       db.nextId,
    name:     name,
    password: hash.hash,
    posts:    []
  };
  db.nextId = db.nextId + 1;
  db.users.push(user);
  print("User created: " + name);
  return { message: "User created", id: user.id };
});

app.post("/login", fn ctx {
  var name     = ctx.body.name;
  var password = ctx.body.password;
  if !name or !password {
    return { error: "name and password are required", code: 400 };
  }
  var user = null;
  for u in db.users {
    if u.name == name {
      user = u;
    }
  }
  if !user {
    return { error: "User not found", code: 404 };
  }
  var hash = new Hash(password);
  if hash.hash != user.password {
    return { error: "Incorrect password", code: 401 };
  }
  var tk    = new Token({ expires: 3600 });
  var key   = "token:" + tk.token;
  wait session.set(key, user.id);
  wait session.ttl(key, 3600);
  print("Login: " + name + " | token: " + tk.token);
  return { token: tk.token, name: user.name };
});

app.get("/profile", fn ctx {
  if ctx.unauthorized {
    return { error: "Unauthorized", code: 401 };
  }
  var user = null;
  for u in db.users {
    if u.id == ctx.userId {
      user = u;
    }
  }
  if !user {
    return { error: "User not found", code: 404 };
  }
  return {
    id:    user.id,
    name:  user.name,
    posts: user.posts.length
  };
});

app.get("/users", fn ctx {
  if ctx.unauthorized {
    return { error: "Unauthorized", code: 401 };
  }
  var list = [];
  for u in db.users {
    list.push({ id: u.id, name: u.name, posts: u.posts.length });
  }
  return { total: list.length, users: list };
});

app.post("/post", fn ctx {
  if ctx.unauthorized {
    return { error: "Unauthorized", code: 401 };
  }
  var title = ctx.body.title;
  var body  = ctx.body.body;
  if !title or !body {
    return { error: "title and body are required", code: 400 };
  }
  var user = null;
  for u in db.users {
    if u.id == ctx.userId {
      user = u;
    }
  }
  if !user {
    return { error: "User not found", code: 404 };
  }
  var post = {
    id:     user.posts.length + 1,
    title:  title,
    body:   body,
    author: user.name
  };
  user.posts.push(post);
  print("Post created by " + user.name + ": " + title);
  return { message: "Post created", post: post };
});

app.get("/posts", fn ctx {
  if ctx.unauthorized {
    return { error: "Unauthorized", code: 401 };
  }
  var allPosts = [];
  for u in db.users {
    for p in u.posts {
      allPosts.push(p);
    }
  }
  return { total: allPosts.length, posts: allPosts };
});

print("Orgapp running at http://localhost:3000");
print("Test:");
print("  POST /register  { name, password }");
print("  POST /login     { name, password }");
print("  GET  /profile   x-token: <token>");
