import App   from CajyuLibs.Orgapp;
import Hash  from CajyuLibs.auth;
import Token from CajyuLibs.auth;
import cache from CajyuLibs.cache;
import print from CajyuLibs.serial;

var db = {
  users: [],
  nextId: 1
};

var session = cache();
var app     = new App(3000);

app.use(fn ctx, res, next {
  print("[" + ctx.type + "] " + ctx.url);
  wait next();
});

app.use(fn ctx, res, next {
  var rotasPublicas = ["/", "/login", "/registrar"];
  var ehPublica = false;
  for i in rotasPublicas {
    if i == ctx.url {
      ehPublica = true;
    }
  }
  if ehPublica {
    wait next();
    return;
  }
  var token  = ctx.headers["x-token"];
  var userId = wait session.get("token:" + token);
  if !userId {
    ctx.unauthorized = true;
  } else {
    ctx.userId = userId;
  }
  wait next();
});

app.get("/", fn ctx {
  return "<html><body>" +
    "<h1>Orgapp Example</h1>" +
    "<p>Available routes:</p>" +
    "<ul>" +
    "<li>POST /registrar — { nome, senha }</li>" +
    "<li>POST /login     — { nome, senha }</li>" +
    "<li>GET  /perfil    — x-token required</li>" +
    "<li>GET  /usuarios  — x-token required</li>" +
    "<li>POST /post      — { titulo, corpo } + x-token</li>" +
    "<li>GET  /posts     — x-token required</li>" +
    "</ul></body></html>";
});

app.post("/registrar", fn ctx {
  if ctx.unauthorized {
    return { erro: "Não autorizado", code: 401 };
  }
  var nome  = ctx.body.nome;
  var senha = ctx.body.senha;
  if !nome or !senha {
    return { erro: "nome e senha obrigatórios", code: 400 };
  }
  var existe = false;
  for u in db.users {
    if u.nome == nome {
      existe = true;
    }
  }
  if existe {
    return { erro: "Usuário já existe", code: 409 };
  }
  var hash = new Hash(senha);
  var user = {
    id:    db.nextId,
    nome:  nome,
    senha: hash.hash,
    posts: []
  };
  db.nextId = db.nextId + 1;
  db.users.push(user);
  print("Usuário criado: " + nome);
  return { mensagem: "Usuário criado", id: user.id };
});

app.post("/login", fn ctx {
  var nome  = ctx.body.nome;
  var senha = ctx.body.senha;
  if !nome or !senha {
    return { erro: "nome e senha obrigatórios", code: 400 };
  }
  var user = null;
  for u in db.users {
    if u.nome == nome {
      user = u;
    }
  }
  if !user {
    return { erro: "Usuário não encontrado", code: 404 };
  }
  var hash = new Hash(senha);
  if hash.hash != user.senha {
    return { erro: "Senha incorreta", code: 401 };
  }
  var tk    = new Token({ expires: 3600 });
  var chave = "token:" + tk.token;
  wait session.set(chave, user.id);
  wait session.ttl(chave, 3600);
  print("Login: " + nome + " | token: " + tk.token);
  return { token: tk.token, nome: user.nome };
});

app.get("/perfil", fn ctx {
  if ctx.unauthorized {
    return { erro: "Não autorizado", code: 401 };
  }
  var user = null;
  for u in db.users {
    if u.id == ctx.userId {
      user = u;
    }
  }
  if !user {
    return { erro: "Usuário não encontrado", code: 404 };
  }
  return {
    id:    user.id,
    nome:  user.nome,
    posts: user.posts.length
  };
});

app.get("/usuarios", fn ctx {
  if ctx.unauthorized {
    return { erro: "Não autorizado", code: 401 };
  }
  var lista = [];
  for u in db.users {
    lista.push({ id: u.id, nome: u.nome, posts: u.posts.length });
  }
  return { total: lista.length, usuarios: lista };
});

app.post("/post", fn ctx {
  if ctx.unauthorized {
    return { erro: "Não autorizado", code: 401 };
  }
  var titulo = ctx.body.titulo;
  var corpo  = ctx.body.corpo;
  if !titulo or !corpo {
    return { erro: "titulo e corpo obrigatórios", code: 400 };
  }
  var user = null;
  for u in db.users {
    if u.id == ctx.userId {
      user = u;
    }
  }
  if !user {
    return { erro: "Usuário não encontrado", code: 404 };
  }
  var post = {
    id:     user.posts.length + 1,
    titulo: titulo,
    corpo:  corpo,
    autor:  user.nome
  };
  user.posts.push(post);
  print("Post criado por " + user.nome + ": " + titulo);
  return { mensagem: "Post criado", post: post };
});

app.get("/posts", fn ctx {
  if ctx.unauthorized {
    return { erro: "Não autorizado", code: 401 };
  }
  var todos = [];
  for u in db.users {
    for p in u.posts {
      todos.push(p);
    }
  }
  return { total: todos.length, posts: todos };
});

print("Orgapp rodando em http://localhost:3000");
print("Teste:");
print("  POST /registrar  { nome, senha }");
print("  POST /login      { nome, senha }");
print("  GET  /perfil     x-token: <token>");
