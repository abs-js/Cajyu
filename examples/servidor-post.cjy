import Server from CajyuLibs.http
import print from CajyuLibs.serial

var server = new Server(3000)
print("Servidor Cajyu pronto na porta 3000")

server.post(fn b {
  if !b.a and !b.b {
    return { code: 400 }
  }
  return {
    code: 200,
    result: b.a + b.b
  }
})

print("POST / com JSON {a, b} para somar")
print("server.sleep() e server.wake() disponíveis")
