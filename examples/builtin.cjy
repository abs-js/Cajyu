// Exemplo de built-ins Bfs e Bexec
import Bfs   from Bfs
import Bexec from Bexec

// Escrita e leitura de arquivo
Bfs.write("teste.txt", "Olá do Cajyu!")
var conteudo = Bfs.read("teste.txt")
print(conteudo)

// Verificar existência
print(Bfs.exists("teste.txt"))

// Executar comando
var resultado = Bexec.run("echo Hello from shell")
print(resultado)

// Limpar
Bfs.remove("teste.txt")
