import Server from CajyuLibs.http
import print from CajyuLibs.serial

var clicks = 0
var server = new Server(3001)
print("Cajyu click server at http://localhost:3001")

var html = "<!DOCTYPE html><html><body><h1>Click Counter (Cajyu)</h1><button id='btn'>Click me</button><p>Total clicks: <span id='count'>0</span></p><script>const btn=document.getElementById('btn');const count=document.getElementById('count');btn.onclick=async()=>{const r=await fetch('/click',{method:'POST'});const data=await r.json();count.textContent=data.clicks;};</script></body></html>"

server.file("/", html)
server.file("index.html", html)

server.post(fn b {
  clicks = clicks + 1
  print("Click #" + clicks)
  return { code: 200, clicks: clicks }
})
