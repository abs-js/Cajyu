import Server from CajyuLibs.http
import print from CajyuLibs.serial

var server = new Server(3000)
print("Cajyu simple server running at http://localhost:3000")

var html = "<!DOCTYPE html><html><head><title>Simple Server</title></head><body><h1>Hello from Cajyu!</h1><p>This is a simple text served by a Cajyu server.</p></body></html>"

server.file("/", html)
server.file("index.html", html)
